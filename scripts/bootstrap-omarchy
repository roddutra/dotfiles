#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
manifest_root="$repo_root/manifests/omarchy"
dry_run=false
include_hardware=false

usage() {
  cat <<'EOF'
Usage: ./scripts/bootstrap-omarchy [--dry-run] [--hardware]

Install curated Omarchy packages, plugins, and the saved theme.

  --dry-run   Print commands without running them.
  --hardware  Include packages specific to this desktop's AMD CPU and NVIDIA GPU.
EOF
}

while (($#)); do
  case "$1" in
    --dry-run) dry_run=true ;;
    --hardware) include_hardware=true ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v omarchy >/dev/null 2>&1; then
  echo "This script must run on Omarchy." >&2
  exit 1
fi

run() {
  if $dry_run; then
    printf '  '
    printf '%q ' "$@"
    printf '\n'
  else
    "$@"
  fi
}

read_manifest() {
  local file=$1
  local -n destination=$2
  local line

  destination=()
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    destination+=("$line")
  done < "$file"
}

install_packages() {
  local command_group=$1
  local manifest=$2
  local packages=()

  read_manifest "$manifest" packages
  ((${#packages[@]})) || return

  if [[ $command_group == repo ]]; then
    run omarchy pkg add "${packages[@]}"
  else
    run omarchy pkg aur add "${packages[@]}"
  fi
}

echo "Installing repository packages..."
install_packages repo "$manifest_root/packages.txt"

echo "Installing AUR packages..."
install_packages aur "$manifest_root/aur-packages.txt"

# System files are installed as root-owned copies, never linked: a link into
# the home directory would let anything running as the user change what root
# loads. Each path is relative to system/omarchy/ and to /.
system_files_changed=false

install_system_file() {
  local path=$1
  local source="$repo_root/system/omarchy/$path"
  local target="/$path"

  if cmp -s "$source" "$target"; then
    echo "  /$path already installed"
    return
  fi

  run sudo install -D -m 644 -o root -g root "$source" "$target"
  system_files_changed=true
}

if $include_hardware; then
  echo "Installing this desktop's hardware packages..."
  install_packages repo "$manifest_root/hardware-packages.txt"

  echo "Installing this desktop's system files..."
  install_system_file etc/modprobe.d/no-hid-kysona.conf

  # The initramfs carries its own copy of modprobe.d, and the keyboard hook
  # includes every HID driver, so rebuild the boot image for the block to
  # apply from early boot.
  if $system_files_changed; then
    run sudo limine-update
  fi
fi

# 1Password's desktop app only connects to browser binaries it recognises, and
# Zen's is not one of them. Without this entry the Zen extension cannot share
# the app's unlock state. 1Password ignores the file unless root owns it.
one_password_allowlist=/etc/1password/custom_allowed_browsers
if [[ -f $one_password_allowlist ]] && grep -qx 'zen-bin' "$one_password_allowlist"; then
  echo "  Zen already allowed in 1Password"
else
  echo "Allowing Zen to connect to the 1Password desktop app..."
  run sudo install -d -o root -g root -m 755 /etc/1password
  run sudo sh -c 'printf "%s\n" zen-bin >> "$1"' _ "$one_password_allowlist"
  run sudo chown root:root "$one_password_allowlist"
  run sudo chmod 755 "$one_password_allowlist"
fi

echo "Restoring Omarchy plugins..."
while IFS='|' read -r plugin_id plugin_url || [[ -n ${plugin_id:-} ]]; do
  [[ -z ${plugin_id:-} || $plugin_id == \#* ]] && continue
  if [[ -d "$HOME/.config/omarchy/plugins/$plugin_id" ]]; then
    echo "  $plugin_id already installed"
  else
    run omarchy plugin add "$plugin_url" --enable --yes
  fi
done < "$manifest_root/plugins.txt"

# The Voxtype OSD plugin's own setup refuses config files that resolve into this
# repository. Tracked config owns its [osd] settings and keybindings, so install
# only its Quickshell files.
echo "Installing the Voxtype OSD HUD..."
voxtype_osd_dir="$HOME/.config/omarchy/plugins/blizl.voxtype-osd"
run bash -c 'source "$1/lib/qml-installer.sh" && qml_install "$1" "$(qml_target_dir)"' _ "$voxtype_osd_dir"

theme_url=$(<"$manifest_root/theme.txt")
if [[ -d "$HOME/.config/omarchy/themes/rose-pine-moon" ]]; then
  echo "  Rose Pine Moon already installed"
else
  echo "Installing Rose Pine Moon..."
  run omarchy theme install "$theme_url"
fi

echo "Omarchy bootstrap complete."
