# macOS
.DS_Store

# Editor temporary files
*.swp
*.swo
*~
.netrwhist

# Environment and secrets
.env
.env.*
!.env.example
packages/macos/zsh/.zshrc
packages/macos/zsh/.zshrc.local
packages/macos/zsh/.zsh-secrets

# Shell history that might accidentally get added
.zsh_history
.bash_history

# Tmux
# Ignore TPM-installed plugins (except our submodules)
packages/common/tmux/.config/tmux/plugins/*
!packages/common/tmux/.config/tmux/plugins/tpm
!packages/common/tmux/.config/tmux/plugins/catppuccin
# Tmux resurrect automatic saves
packages/common/tmux/.config/tmux/resurrect/

# Neovim
packages/*/nvim/.config/nvim/plugin/packer_compiled.lua
packages/*/nvim/.config/nvim/lazy-lock.json

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# SSH (safety - in case someone accidentally tries to add these)
ssh/.ssh/id_*
!ssh/.ssh/id_*.pub
ssh/.ssh/known_hosts

# GPG
gnupg/.gnupg/random_seed
gnupg/.gnupg/*.lock

# Git credentials (safety)
git/.config/git/credentials

# Node
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Claude Code - ignore all files and directories except version-controlled configs
packages/common/claude/.claude/*
!packages/common/claude/.claude/agents/
!packages/common/claude/.claude/commands/
!packages/common/claude/.claude/hooks/
!packages/common/claude/.claude/skills/
!packages/common/claude/.claude/CLAUDE.md
.tmp/

# Grok CLI - ignore everything except version-controlled config
packages/common/grok/.grok/*
!packages/common/grok/.grok/config.toml
!packages/common/grok/.grok/skills/
!packages/common/grok/.grok/agents/

# herdr - skill and integration hook are installed/updated by the herdr binary
# itself (`herdr --skill`, `herdr integration`) on each machine; tracking them
# only causes conflicts between installs
packages/common/agents/.agents/skills/herdr/
packages/common/claude/.claude/skills/herdr
packages/common/claude/.claude/hooks/herdr-agent-state.sh

# Oh My Pi - track only reviewed portable configuration
packages/common/omp/.omp/agent/*
!packages/common/omp/.omp/agent/config.yml

# Omarchy generated, local, and downloaded state
packages/omarchy/hypr/.config/hypr/*.bak.*
packages/omarchy/hypr/.config/hypr/hyprmoncfg-monitors.lua
packages/omarchy/hypr/.config/hypr/monitors.local.lua
packages/omarchy/hypr/.config/hypr/omasettings*
packages/omarchy/omarchy/.config/omarchy/plugins/
packages/omarchy/omarchy/.config/omarchy/themes/
packages/omarchy/omarchy/.config/omarchy/hass.json
