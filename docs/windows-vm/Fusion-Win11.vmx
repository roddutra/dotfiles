pciBridge7.functions = "8"
vmci0.present = "TRUE"
hpet0.present = "TRUE"
svga.present = "TRUE"
mks.enable3d = "TRUE"
svga.graphicsMemoryKB = "4194304"
nvme0.present = "TRUE"
nvme0:0.present = "TRUE"
