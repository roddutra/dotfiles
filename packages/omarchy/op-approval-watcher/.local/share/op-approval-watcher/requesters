#!/usr/bin/env bash
# List the processes that could be waiting on a 1Password approval window.
# Used by the approval watcher to corroborate a window before it counts as an
# approval. Linux only and read-only: it uses `ss` and /proc, and never talks
# to the SSH agent or 1Password.
#
#   requesters --opened-at EPOCH   the window opened at EPOCH (seconds, decimals allowed)
#   requesters --reconciled        the window was already open when the watcher started
#
# Candidates:
#   ssh-agent  every client of the 1Password SSH agent socket. A waiting ssh
#              stays connected for the whole prompt. Sockets considered:
#              SSH_AUTH_SOCK, every IdentityAgent in ~/.ssh/config and
#              ~/.1password/agent.sock, kept only when a 1Password process
#              listens on them.
#   op         `op` processes of this user, except `op daemon`, that started
#              no later than EPOCH and at most 5 s before it (plus 0.2 s for
#              start-time sampling, on the early side only). With
#              --reconciled, any younger than 65 s.
#
# Prints one JSON object:
#   {"sockets":["..."],"candidates":[{"pid":N,"comm":"..","source":"ssh-agent|op"}]}
#
# Exit codes:
#   0   printed (no candidates is a normal result)
#   1   ss or jq is missing
#   64  bad usage
set -euo pipefail

op_window_before=5
op_early_slack=0.2
reconciled_max_age=65

usage() {
  printf 'usage: requesters --opened-at EPOCH | --reconciled\n' >&2
  exit 64
}

opened_at=''
reconciled=false
case "${1:-}" in
  --opened-at)
    [[ $# -eq 2 && $2 =~ ^[0-9]+(\.[0-9]+)?$ ]] || usage
    opened_at=$2
    ;;
  --reconciled)
    [[ $# -eq 1 ]] || usage
    reconciled=true
    ;;
  *) usage ;;
esac

if ! command -v ss >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  printf 'requesters: ss and jq are required\n' >&2
  exit 1
fi

expand_path() {
  local p=$1
  p=${p#\"}
  p=${p%\"}
  # ssh_config writes these literally; match the text, do not expand it.
  # shellcheck disable=SC2088,SC2016
  case $p in
    "~/"*) p="$HOME/${p#\~/}" ;;
    '$HOME/'* | '${HOME}/'*) p="$HOME/${p#*/}" ;;
  esac
  printf '%s\n' "$p"
}

# Candidate socket paths, in the order ssh would consider them.
paths=()
[[ -z ${SSH_AUTH_SOCK:-} ]] || paths+=("$SSH_AUTH_SOCK")
if [[ -r $HOME/.ssh/config ]]; then
  while IFS= read -r ia; do
    [[ -n $ia && $ia != none ]] && paths+=("$(expand_path "$ia")")
  done < <(awk 'tolower($1) == "identityagent" { print $2 }' "$HOME/.ssh/config")
fi
paths+=("$HOME/.1password/agent.sock")

listeners=$(ss -xlp 2>/dev/null || true)
sockets=()
for p in "${paths[@]}"; do
  [[ -S $p ]] || continue
  for s in "${sockets[@]}"; do [[ $s == "$p" ]] && continue 2; done
  # Keep only sockets a 1Password process listens on, so another agent's
  # clients (gnome-keyring, ssh-agent) never count.
  if awk -v sock="$p" 'NR > 1 && $5 == sock && tolower($0) ~ /\("1password"/ { found = 1 } END { exit !found }' <<<"$listeners"; then
    sockets+=("$p")
  fi
done

# Lines of "pid<TAB>comm<TAB>source".
candidates=''

if ((${#sockets[@]})); then
  # Server-side accepted sockets show the socket path as Local Address and the
  # client's inode as Peer Port; the client socket is the one whose Local Port
  # is that inode, and users:(...) names its process.
  candidates+=$(ss -xap 2>/dev/null | awk -v socks="$(printf '%s\n' "${sockets[@]}")" '
    BEGIN { n = split(socks, list, "\n"); for (i = 1; i <= n; i++) if (list[i] != "") sock[list[i]] = 1 }
    NR == 1 { next }
    {
      proc = ""
      for (i = 9; i <= NF; i++) proc = proc (proc == "" ? "" : " ") $i
      if (($5 in sock) && $2 == "ESTAB") { want[$8] = 1; next }
      lp[NR] = $6; pr[NR] = proc
    }
    END {
      for (r in lp) {
        if (!(lp[r] in want)) continue
        p = pr[r]
        while (match(p, /\("[^"]*",pid=[0-9]+,fd=[0-9]+\)/)) {
          e = substr(p, RSTART + 2, RLENGTH - 3)
          p = substr(p, RSTART + RLENGTH)
          split(e, a, ",")
          comm = a[1]; sub(/"$/, "", comm)
          pid = a[2]; sub(/^pid=/, "", pid)
          if (!(pid in seen)) { seen[pid] = 1; printf "%s\t%s\tssh-agent\n", pid, comm }
        }
      }
    }')
  [[ -z $candidates ]] || candidates+=$'\n'
fi

# op processes: start time from /proc/<pid>/stat field 22 (clock ticks since
# boot), turned into an epoch through /proc/uptime. Both count suspend time.
uid=$(id -u)
hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
op_lines=''
for dir in /proc/[0-9]*; do
  pid=${dir#/proc/}
  [[ -r $dir/comm ]] || continue
  comm=$(<"$dir/comm") 2>/dev/null || continue
  [[ $comm == op ]] || continue
  [[ $(stat -c %u "$dir" 2>/dev/null) == "$uid" ]] || continue
  argv1=$(tr '\0' '\n' <"$dir/cmdline" 2>/dev/null | sed -n 2p) || argv1=''
  [[ $argv1 == daemon ]] && continue
  stat_line=$(<"$dir/stat") 2>/dev/null || continue
  rest=${stat_line##*) }
  read -r -a fields <<<"$rest"
  start_ticks=${fields[19]:-}
  [[ $start_ticks =~ ^[0-9]+$ ]] || continue
  op_lines+="$pid $start_ticks"$'\n'
done

if [[ -n $op_lines ]]; then
  read -r uptime _ </proc/uptime
  now=$(date +%s.%N)
  candidates+=$(awk -v now="$now" -v up="$uptime" -v hz="$hz" -v opened="$opened_at" \
    -v reconciled="$reconciled" -v before="$op_window_before" -v slack="$op_early_slack" \
    -v maxage="$reconciled_max_age" '
    NF == 2 {
      started = now - (up - $2 / hz)
      if (reconciled == "true") {
        if (now - started <= maxage) printf "%s\top\top\n", $1
      } else if (started >= opened - before - slack && started <= opened) {
        printf "%s\top\top\n", $1
      }
    }' <<<"$op_lines")
fi

printf '%s' "$candidates" | jq -Rsc --args '
  {sockets: $ARGS.positional,
   candidates: [split("\n")[] | select(length > 0) | split("\t")
                | select(length == 3 and (.[0] | test("^[0-9]+$")))
                | {pid: (.[0] | tonumber), comm: .[1], source: .[2]}]}' "${sockets[@]}"
