{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "format": "ddd d MMM h:mm AP",
          "id": "omarchy.clock"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.kristoferlund.webcam",
          "device": "/dev/video0"
        },
        {
          "id": "quickshell.spotify",
          "deviceName": "Omarchy Spotify",
          "idleShutdownMinutes": 15,
          "showMiniPlayer": "On",
          "shortcutPlayer": "Omarchy Music app",
          "shortcutHints": "On",
          "showTrackTitle": "On",
          "showArtistName": "Off",
          "scrollBarText": "Off",
          "scrollSpeed": "1",
          "maxBarTextWidth": "240",
          "audioQuality": "320 kbps",
          "showVinylRecord": "Off",
          "showLyrics": "On",
          "showPausedTrack": "On",
          "fixedBarWidth": "Off",
          "showArtwork": "On",
          "clientId": ""
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.thetrueferret.decent-workspaces",
          "showEmpty": true,
          "maxIcons": 3
        }
      ],
      "right": [
        {
          "id": "io.github.tyrichards.tray",
          "hidden": [],
          "order": [
            "1Password_status_icon_1",
            "dank-calendar",
            "NordVPN",
            "systray",
            "tray-icon tray app 47890-1"
          ],
          "showTrayIcons": true
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "io.weirdware.blueferry"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "sh.lerd.glance"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "hass"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "lgse.sandman"
        },
        {
          "id": "jankeesvw.notification-center"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 604800,
    "screensaver": 900
  },
  "plugins": [
    {
      "id": "omadock"
    },
    {
      "id": "io.github.twiking.omasettings"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "split"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
