[Unit]
Description=Start wayvnc for DP-2 once that monitor is connected
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
# The service skips itself while DP-2 is absent; retry every 30 s while it is
# not running. OnActiveSec covers the case where it has never started.
OnActiveSec=30s
OnUnitInactiveSec=30s
AccuracySec=5s

[Install]
WantedBy=graphical-session.target
