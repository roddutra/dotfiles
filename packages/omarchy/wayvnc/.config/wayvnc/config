# wayvnc for Termix remote desktop. Docs: docs/omarchy.md, "Remote desktop with wayvnc".
# Listening addresses and the captured output are set per service, not here.
enable_auth=true
enable_pam=true
# Self-signed TLS pair, generated on this machine and kept untracked in
# ~/.config/wayvnc/. The paths are relative to the services' WorkingDirectory:
# use_relative_paths would resolve them inside this repository instead.
certificate_file=tls_cert.pem
private_key_file=tls_key.pem
