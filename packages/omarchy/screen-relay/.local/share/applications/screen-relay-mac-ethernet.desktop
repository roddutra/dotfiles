# Opens the Mac's screen-relay viewer. See docs/screen-relay.md.
[Desktop Entry]
Type=Application
Name=Mac Desktop (Ethernet)
Comment=Control the Mac in the browser through an SSH tunnel to its Ethernet address (lower latency)
Exec=screen-relay-launch --tunnel rfd-mbp-eth
Icon=preferences-desktop-remote-desktop
Terminal=false
Categories=Network;RemoteAccess;
Keywords=screen-relay;remote;desktop;vnc;mac;macbook;ethernet;wired;
