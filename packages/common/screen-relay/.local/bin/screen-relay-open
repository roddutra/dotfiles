#!/bin/bash
# Open another machine's screen-relay viewer in the browser. Links are fetched
# over SSH with screen-relay-link on that host and handed straight to the
# browser, so tokens are not printed.
#
#   screen-relay-open HOST [SESSION]            Tailscale link
#   screen-relay-open --all HOST                one tab per running session (each monitor)
#   screen-relay-open --tunnel HOST [SESSION]   open an SSH tunnel to the engine port first
#   screen-relay-open --print HOST [SESSION]    print the links instead of opening them
#
# HOST is anything ssh accepts: an alias, user@lan-ip or a Tailscale name.
# SESSION picks one session on a host that runs several, such as dp-2 for
# Omarchy's second monitor. Without it, the host picks its first session.
set -euo pipefail

usage() { echo "usage: screen-relay-open [--tunnel] [--print] [--all] HOST [SESSION]" >&2; exit 64; }

tunnel=0 print=0 all=0 host="" session=""
for arg in "$@"; do
  case $arg in
    --tunnel) tunnel=1 ;;
    --print) print=1 ;;
    --all) all=1 ;;
    -*) usage ;;
    *)
      if [[ -z $host ]]; then host=$arg
      elif [[ -z $session ]]; then session=$arg
      else usage; fi
      ;;
  esac
done
[[ -n $host ]] || usage
((all)) && [[ -n $session ]] && usage
[[ -z $session || $session =~ ^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,63}$ ]] || usage

remote='~/.local/bin/screen-relay-link'
((tunnel)) && remote+=' --tunnel'
((all)) && remote+=' --all'
[[ -n $session ]] && remote+=" $session"
output=$(ssh "$host" "$remote")
links=()
while IFS= read -r line; do
  [[ -n $line ]] && links+=("$line")
done <<<"$output"
((${#links[@]})) || exit 1

if ((tunnel)); then
  # The viewer only accepts a loopback page on the same port the engine uses,
  # so each session's engine port is forwarded to the same local port. A port
  # that is already listening could be this machine's own engine or a tunnel
  # to another host, so it is never reused.
  forwards=()
  for link in "${links[@]}"; do
    port=${link#http://127.0.0.1:}
    port=${port%%/*}
    if nc -z 127.0.0.1 "$port" 2>/dev/null; then
      echo "screen-relay-open: local port $port is already in use; close the old tunnel or free the port, then retry" >&2
      exit 1
    fi
    forwards+=(-L "$port:127.0.0.1:$port")
  done
  ssh -f -N -o ExitOnForwardFailure=yes "${forwards[@]}" "$host"
  echo "screen-relay-open: tunnel open; close it with: pkill -f 'ssh -f -N -o ExitOnForwardFailure=yes ${forwards[*]} $host'" >&2
fi

for link in "${links[@]}"; do
  if ((print)); then
    printf '%s\n' "$link"
  elif [[ $(uname -s) == Darwin ]]; then
    open "$link"
  else
    xdg-open "$link" >/dev/null 2>&1 &
  fi
done
